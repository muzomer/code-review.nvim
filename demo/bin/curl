#!/usr/bin/env python3
# Stands in for curl in the PR demo: serves the invented PR acme/payments#128
# from demo/pr/ the way the GitHub API would (body, then "\n<status>").
import json, os, re, sys, urllib.parse

pr_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "pr")
url = sys.argv[-1]
SHAS = {"a1b2c3d4e5f6": "base", "f6e5d4c3b2a1": "head"}

def reply(body, status=200):
    sys.stdout.write(body + "\n" + str(status))
    sys.exit(0)

m = re.search(r"/repos/acme/payments/(.*)$", url)
if not m:
    reply("", 404)
rest = m.group(1)
path, _, query = rest.partition("?")
q = urllib.parse.parse_qs(query)
if path == "pulls/128":
    reply(open(os.path.join(pr_dir, "pull.json")).read())
if path == "pulls/128/files":
    reply(open(os.path.join(pr_dir, "files.json")).read() if q.get("page", ["1"])[0] == "1" else "[]")
if path.startswith("contents/"):
    side = SHAS.get(q.get("ref", [""])[0])
    f = os.path.join(pr_dir, side or "-", urllib.parse.unquote(path[len("contents/"):]))
    if side and os.path.isfile(f):
        reply(open(f).read())
reply('{"message": "Not Found"}', 404)
